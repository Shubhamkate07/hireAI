FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .


FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm ci --omit=dev

COPY --from=builder /app/src ./src
COPY --from=builder /app/server.js ./server.js

# Ensure uploads directory structure exists in production container
RUN mkdir -p uploads/resumes

EXPOSE 5000

CMD ["node", "server.js"]