# ─────────────────────────────────────────────────────────────────────────────
# HireAI — Environment Variables
# Copy this file to .env and fill in all required values.
# Required vars are marked [REQUIRED] — the server will refuse to start without them.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development          # development | production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  leave blank (defaults to http://localhost:5173)
# Prod: CORS_ORIGINS=https://yourdomain.com
# Multiple origins: CORS_ORIGINS=https://app.com,https://admin.app.com
CORS_ORIGINS=

# ─── Database [REQUIRED] ──────────────────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# ─── JWT [REQUIRED] ───────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5